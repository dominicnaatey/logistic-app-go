# Server Configuration
GO_ENV=development
PORT=8080

# Database (Neon PostgreSQL + PostGIS)
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://username:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# For local development (Docker):
# DATABASE_URL=postgresql://logistic_user:logistic_pass@localhost:5432/logistic_app?sslmode=disable

# Upstash Redis (Serverless - REST API)
# Get your credentials from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# For local development (Docker):
# UPSTASH_REDIS_REST_URL=http://localhost:8079
# UPSTASH_REDIS_REST_TOKEN=

# Africa's Talking SMS
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SENDER_ID=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# JWT Configuration
# Generate a secure key with: go run cmd/keygen/main.go
# Must be at least 32 characters long
JWT_SECRET=your-super-secret-jwt-key-replace-this-with-32-plus-chars
JWT_EXPIRES_IN=168h  # 7 days

# Paystack (Ghana payments)
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# Flutterwave (Cross-border + Mali)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxx

# Firebase Cloud Messaging (Push notifications)
FCM_SERVER_KEY=your-fcm-server-key

# Sentry (Error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Mapbox (Optional - for route calculations)
MAPBOX_ACCESS_TOKEN=pk.xxxxx
